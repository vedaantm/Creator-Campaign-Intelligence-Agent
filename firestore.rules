rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Default deny for unmapped paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Users collection
    match /users/{uid} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid);
    }

    // Campaigns collection
    match /campaigns/{campaignId} {
      allow read: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid ||
        (resource.data.memberEmails != null && request.auth.token.email in resource.data.memberEmails)
      );
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid ||
        (resource.data.memberEmails != null && request.auth.token.email in resource.data.memberEmails)
      );
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;

      // Subcollections
      match /{subcollection}/{docId} {
        allow read, write: if isSignedIn() && (
          get(/databases/$(database)/documents/campaigns/$(campaignId)).data.ownerId == request.auth.uid ||
          request.auth.token.email in get(/databases/$(database)/documents/campaigns/$(campaignId)).data.memberEmails
        );
      }
    }

    // Jobs collection
    match /jobs/{jobId} {
      allow read: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow write: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
    }
  }
}
